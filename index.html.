
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#111111">
<meta name="description" content="Site oficial do FUTBOI FC. Jogos, resultados e elenco.">
<title>FUTBOI FC | Oficial</title>

<style>
:root {
  --red: #e21b2d;
  --black: #111;
  --panel: #1b1b1b;
  --gray: #aaa;
  --white: #f7f7f7;
}
* { box-sizing: border-box; }
body {
  margin: 0;
  background: var(--black);
  color: var(--white);
  font-family: Arial, sans-serif;
}
header {
  padding: 25px 16px;
  text-align: center;
  background: linear-gradient(135deg,#210408,#111 65%);
  border-bottom: 3px solid var(--red);
}
.crest {
  width: 86px;
  height: 86px;
  margin: auto auto 12px;
  border: 3px solid var(--red);
  border-radius: 50%;
  display: grid;
  place-items: center;
  font-size: 35px;
  background: #111;
}
h1 { margin: 5px 0; letter-spacing: 3px; }
header p { color: #ccc; margin-bottom: 0; }
nav {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 8px;
  padding: 14px;
  background: #181818;
  position: sticky;
  top: 0;
  z-index: 5;
}
button, .navlink {
  background: var(--red);
  color: white;
  border: 0;
  padding: 11px 14px;
  border-radius: 6px;
  font-weight: bold;
  cursor: pointer;
  text-decoration: none;
}
button.secondary { background: #383838; }
button.danger { background: #8d101c; }
button:hover { filter: brightness(1.12); }
main { max-width: 1000px; margin: auto; padding: 18px; }
section { margin: 25px 0 40px; }
h2 {
  border-left: 5px solid var(--red);
  padding-left: 12px;
}
.muted { color: var(--gray); }
.card {
  background: var(--panel);
  border: 1px solid #333;
  border-radius: 12px;
  padding: 18px;
  margin: 12px 0;
}
.match-top {
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 8px;
}
.tag {
  display: inline-block;
  background: #401017;
  color: #ffb7bd;
  padding: 5px 9px;
  border-radius: 5px;
  font-size: 12px;
  margin: 3px 3px 3px 0;
}
.teams {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  gap: 12px;
  align-items: center;
  text-align: center;
  margin: 24px 0;
}
.team { font-size: 17px; font-weight: bold; overflow-wrap: anywhere; }
.score { font-size: 28px; font-weight: bold; }
.player-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit,minmax(145px,1fr));
  gap: 12px;
}
.player { text-align: center; padding: 15px 8px; }
.player img {
  width: 86px; height: 86px;
  object-fit: cover; border-radius: 50%;
  border: 2px solid var(--red);
}
.number { color: var(--red); font-size: 27px; font-weight: bold; }
input, select, textarea {
  display: block;
  width: 100%;
  padding: 12px;
  margin: 7px 0 14px;
  border-radius: 6px;
  border: 1px solid #444;
  background: #101010;
  color: white;
  font: inherit;
}
label { font-size: 14px; color: #ddd; }
form { max-width: 650px; }
.form-actions, .actions {
  display: flex; flex-wrap: wrap; gap: 8px;
}
.hidden { display: none !important; }
.empty { text-align: center; padding: 25px; color: #aaa; }
footer {
  text-align: center;
  padding: 25px;
  border-top: 1px solid #333;
  color: #888;
}
.notice {
  padding: 12px;
  border: 1px solid #65424a;
  border-radius: 7px;
  color: #ffc5cb;
  background: #281014;
  margin: 12px 0;
}
@media(max-width:480px) {
  main { padding: 12px; }
  .teams { gap: 5px; }
  .team { font-size: 14px; }
}
</style>
</head>

<body>
<header>
  <div class="crest">🐂</div>
  <h1>FUTBOI FC</h1>
  <p>RAÇA • UNIÃO • FUTEBOL</p>
  <p class="muted">SITE OFICIAL DO CLUBE</p>
</header>

<nav>
  <a class="navlink" href="#jogos">Jogos</a>
  <a class="navlink" href="#elenco">Elenco</a>
  <button id="adminButton">Painel administrativo</button>
</nav>

<main>
  <section id="jogos">
    <h2>⚽ Próximas partidas</h2>
    <p class="muted">
      Confira os próximos compromissos do FUTBOI FC.
    </p>
    <div id="matches"></div>
  </section>

  <section id="elenco">
    <h2>🐂 Nosso elenco</h2>
    <p class="muted">Os jogadores que representam o FUTBOI FC.</p>
    <div id="players" class="player-grid"></div>
  </section>

  <section id="admin" class="hidden">
    <h2>🔒 Painel administrativo</h2>

    <div id="login">
      <p class="muted">
        Entre para gerenciar partidas e jogadores neste navegador.
      </p>
      <div class="notice">
        Atenção: a senha desta versão é apenas uma barreira visual.
        Ela não protege o site contra acesso técnico ao código.
      </div>
      <form id="loginForm">
        <label for="password">Senha do painel</label>
        <input id="password" type="password" required
               autocomplete="current-password">
        <button type="submit">Entrar</button>
      </form>
      <p id="loginMessage" class="muted"></p>
    </div>

    <div id="dashboard" class="hidden">
      <div class="notice">
        As alterações são salvas neste navegador. Para atualizar os dados
        que todos os visitantes veem, será necessário conectar um banco
        de dados online.
      </div>

      <button id="logout" class="secondary">Sair do painel</button>

      <h3>Gerenciar partidas</h3>
      <form id="matchForm">
        <input type="hidden" id="matchId">

        <label for="championship">Campeonato</label>
        <input id="championship" required placeholder="Ex.: Campeonato Municipal">

        <label for="category">Categoria</label>
        <input id="category" required placeholder="Ex.: Sub-14">

        <label for="opponent">Adversário</label>
        <input id="opponent" required placeholder="Nome do adversário">

        <label for="matchDate">Data da partida</label>
        <input id="matchDate" type="date" required>

        <label for="matchTime">Horário de início</label>
        <input id="matchTime" type="time" required>

        <label for="venue">Local</label>
        <input id="venue" placeholder="Campo ou estádio">

        <label for="matchStatus">Situação</label>
        <select id="matchStatus">
          <option value="scheduled">Agendada</option>
          <option value="finished">Finalizada</option>
        </select>

        <label for="ourScore">Gols do FUTBOI FC (opcional)</label>
        <input id="ourScore" type="number" min="0" placeholder="Placar">

        <label for="theirScore">Gols do adversário (opcional)</label>
        <input id="theirScore" type="number" min="0" placeholder="Placar">

        <div class="form-actions">
          <button type="submit">Salvar partida</button>
          <button type="button" class="secondary"
                  id="cancelMatch">Limpar formulário</button>
        </div>
      </form>

      <div id="adminMatches"></div>

      <h3>Gerenciar jogadores</h3>
      <form id="playerForm">
        <input type="hidden" id="playerId">

        <label for="playerName">Nome do jogador</label>
        <input id="playerName" required placeholder="Nome">

        <label for="playerNumber">Número da camisa</label>
        <input id="playerNumber" type="number" min="0" max="99"
               required placeholder="Ex.: 10">

        <label for="playerPosition">Posição</label>
        <input id="playerPosition" required
               placeholder="Ex.: Goleiro, zagueiro, atacante">

        <label for="playerPhoto">Link da foto (opcional)</label>
        <input id="playerPhoto" type="url" placeholder="https://...">

        <div class="form-actions">
          <button type="submit">Salvar jogador</button>
          <button type="button" class="secondary"
                  id="cancelPlayer">Limpar formulário</button>
        </div>
      </form>

      <div id="adminPlayers"></div>
    </div>
  </section>
</main>

<footer>
  <strong>FUTBOI FC</strong>
  <p>Site oficial • Paixão pelo futebol</p>
</footer>

<script>
"use strict";

// DEMONSTRAÇÃO LOCAL:
// Troque esta senha somente para testar.
// Uma senha escrita no JavaScript não é segura para produção.
const DEMO_PASSWORD = "FutboiV5!";

const MATCH_KEY = "futboi_v5_matches";
const PLAYER_KEY = "futboi_v5_players";

const $ = id => document.getElementById(id);

function readData(key, fallback) {
  try {
    const value = localStorage.getItem(key);
    return value ? JSON.parse(value) : fallback;
  } catch {
    return fallback;
  }
}

let matches = readData(MATCH_KEY, []);
let players = readData(PLAYER_KEY, []);
let loggedIn = false;

function saveData() {
  try {
    localStorage.setItem(MATCH_KEY, JSON.stringify(matches));
    localStorage.setItem(PLAYER_KEY, JSON.stringify(players));
    return true;
  } catch (error) {
    alert("Não foi possível salvar os dados neste navegador.");
    return false;
  }
}

function escapeHTML(value) {
  return String(value ?? "").replace(/[&<>"']/g, char => ({
    "&": "&amp;",
    "<": "&lt;",
    ">": "&gt;",
    '"': "&quot;",
    "'": "&#39;"
  })[char]);
}

function validPhoto(url) {
  try {
    const parsed = new URL(url);
    return parsed.protocol === "https:" || parsed.protocol === "http:";
  } catch {
    return false;
  }
}

// Usa data e horário locais do navegador.
// A partida some da agenda 60 minutos após o início.
// A remoção é apenas da agenda pública; o cadastro é mantido.
function getMatchStart(match) {
  const dateTime = new Date(
    `${match.date}T${match.time}:00`
  );
  return dateTime.getTime();
}

function isHiddenFromSchedule(match) {
  if (match.status === "finished") return true;

  const start = getMatchStart(match);
  if (!Number.isFinite(start)) return false;

  return Date.now() >= start + 60 * 60 * 1000;
}

function formatDate(date) {
  if (!date) return "Data não informada";
  const parts = date.split("-");
  if (parts.length !== 3) return date;
  return `${parts[2]}/${parts[1]}/${parts[0]}`;
}

function publicMatches() {
  return matches.filter(match => !isHiddenFromSchedule(match))
    .sort((a, b) =>
      getMatchStart(a) - getMatchStart(b)
    );
}

function renderMatches() {
  const list = publicMatches();

  if (!list.length) {
    $("matches").innerHTML =
      '<div class="card empty">Nenhuma partida agendada no momento.</div>';
    return;
  }

  $("matches").innerHTML = list.map(match => {
    const hasScore = match.ourScore !== "" &&
      match.theirScore !== "" &&
      match.ourScore != null &&
      match.theirScore != null;

    const score = hasScore
      ? `<div class="score">${escapeHTML(match.ourScore)} – ${escapeHTML(match.theirScore)}</div>`
      : '<div class="score">VS</div>';

    return `
      <article class="card">
        <div class="match-top">
          <span class="tag">${escapeHTML(match.championship)}</span>
          <span class="tag">${escapeHTML(match.category)}</span>
        </div>
        <div class="teams">
          <div class="team">🐂 FUTBOI FC</div>
          ${score}
          <div class="team">${escapeHTML(match.opponent)}</div>
        </div>
        <p>📅 ${escapeHTML(formatDate(match.date))}</p>
        <p>🕒 ${escapeHTML(match.time)}</p>
        <p>📍 ${escapeHTML(match.venue || "Local a confirmar")}</p>
        <p class="muted">${match.status === "finished" ? "Finalizada" : "Agendada"}</p>
      </article>`;
  }).join("");
}

function renderPlayers() {
  if (!players.length) {
    $("players").innerHTML =
      '<div class="card empty">O elenco será divulgado em breve.</div>';
    return;
  }

  $("players").innerHTML = players.map(player => {
    const photo = validPhoto(player.photo || "");
    return `
      <article class="card player">
        ${photo
          ? `<img src="${escapeHTML(player.photo)}" alt="Foto de ${escapeHTML(player.name)}" loading="lazy" onerror="this.style.display='none'">`
          : '<div class="crest">🐂</div>'}
        <div class="number">#${escapeHTML(player.number)}</div>
        <h3>${escapeHTML(player.name)}</h3>
        <p class="muted">${escapeHTML(player.position)}</p>
      </article>`;
  }).join("");
}

function renderAdmin() {
  if (!loggedIn) return;

  $("adminMatches").innerHTML =
    "<h4>Partidas cadastradas</h4>" +
    (matches.length ? matches.map(match => `
      <div class="card">
        <strong>${escapeHTML(match.opponent)}</strong>
        <p>${escapeHTML(match.championship)} · ${escapeHTML(match.category)}</p>
        <p>${escapeHTML(formatDate(match.date))} às ${escapeHTML(match.time)}</p>
        <p>${isHiddenFromSchedule(match)
          ? "Fora da agenda pública"
          : "Visível na agenda pública"}</p>
        <div class="actions">
          <button class="secondary" data-edit-match="${escapeHTML(match.id)}">Editar</button>
          <button class="danger" data-delete-match="${escapeHTML(match.id)}">Excluir</button>
        </div>
      </div>`).join("")
      : '<p class="muted">Nenhuma partida cadastrada.</p>');

  $("adminPlayers").innerHTML =
    "<h4>Jogadores cadastrados</h4>" +
    (players.length ? players.map(player => `
      <div class="card">
        <strong>#${escapeHTML(player.number)} ${escapeHTML(player.name)}</strong>
        <p>${escapeHTML(player.position)}</p>
        <div class="actions">
          <button class="secondary" data-edit-player="${escapeHTML(player.id)}">Editar</button>
          <button class="danger" data-delete-player="${escapeHTML(player.id)}">Excluir</button>
        </div>
      </div>`).join("")
      : '<p class="muted">Nenhum jogador cadastrado.</p>');
}

function renderAll() {
  renderMatches();
  renderPlayers();
  renderAdmin();
}

function resetMatchForm() {
  $("matchForm").reset();
  $("matchId").value = "";
  $("matchStatus").value = "scheduled";
}

function resetPlayerForm() {
  $("playerForm").reset();
  $("playerId").value = "";
}

$("adminButton").addEventListener("click", () => {
  $("admin").classList.toggle("hidden");
  $("admin").scrollIntoView({ behavior: "smooth" });
});

$("loginForm").addEventListener("submit", event => {
  event.preventDefault();

  if ($("password").value !== DEMO_PASSWORD) {
    $("loginMessage").textContent = "Senha incorreta.";
    return;
  }

  loggedIn = true;
  $("login").classList.add("hidden");
  $("dashboard").classList.remove("hidden");
  $("loginMessage").textContent = "";
  $("password").value = "";
  renderAdmin();
});

$("logout").addEventListener("click", () => {
  loggedIn = false;
  $("dashboard").classList.add("hidden");
  $("login").classList.remove("hidden");
});

$("matchForm").addEventListener("submit", event => {
  event.preventDefault();
  if (!loggedIn) return;

  const id = $("matchId").value || crypto.randomUUID();

  const match = {
    id,
    championship: $("championship").value.trim(),
    category: $("category").value.trim(),
    opponent: $("opponent").value.trim(),
    date: $("matchDate").value,
    time: $("matchTime").value,
    venue: $("venue").value.trim(),
    status: $("matchStatus").value,
    ourScore: $("ourScore").value,
    theirScore: $("theirScore").value
  };

  if (!match.date || !match.time) {
    alert("Informe a data e o horário da partida.");
    return;
  }

  const index = matches.findIndex(item => item.id === id);
  if (index >= 0) matches[index] = match;
  else matches.push(match);

  if (saveData()) {
    resetMatchForm();
    renderAll();
    alert("Partida salva neste navegador!");
  }
});

$("playerForm").addEventListener("submit", event => {
  event.preventDefault();
  if (!loggedIn) return;

  const id = $("playerId").value || crypto.randomUUID();
  const photo = $("playerPhoto").value.trim();

  if (photo && !validPhoto(photo)) {
    alert("Informe um link de foto válido começando com http:// ou https://.");
    return;
  }

  const player = {
    id,
    name: $("playerName").value.trim(),
    number: $("playerNumber").value,
    position: $("playerPosition").value.trim(),
    photo
  };

  const index = players.findIndex(item => item.id === id);
  if (index >= 0) players[index] = player;
  else players.push(player);

  if (saveData()) {
    resetPlayerForm();
    renderAll();
    alert("Jogador salvo neste navegador!");
  }
});

$("cancelMatch").addEventListener("click", resetMatchForm);
$("cancelPlayer").addEventListener("click", resetPlayerForm);

$("adminMatches").addEventListener("click", event => {
  if (!loggedIn) return;

  const edit = event.target.closest("[data-edit-match]");
  const del = event.target.closest("[data-delete-match]");

  if (edit) {
    const match = matches.find(item =>
      item.id === edit.dataset.editMatch
    );
    if (!match) return;

    $("matchId").value = match.id;
    $("championship").value = match.championship;
    $("category").value = match.category;
    $("opponent").value = match.opponent;
    $("matchDate").value = match.date;
    $("matchTime").value = match.time;
    $("venue").value = match.venue || "";
    $("matchStatus").value = match.status;
    $("ourScore").value = match.ourScore ?? "";
    $("theirScore").value = match.theirScore ?? "";
    $("matchForm").scrollIntoView({ behavior: "smooth" });
  }

  if (del && confirm("Excluir esta partida permanentemente deste navegador?")) {
    matches = matches.filter(item =>
      item.id !== del.dataset.deleteMatch
    );
    if (saveData()) renderAll();
  }
});

$("adminPlayers").addEventListener("click", event => {
  if (!loggedIn) return;

  const edit = event.target.closest("[data-edit-player]");
  const del = event.target.closest("[data-delete-player]");

  if (edit) {
    const player = players.find(item =>
      item.id === edit.dataset.editPlayer
    );
    if (!player) return;

    $("playerId").value = player.id;
    $("playerName").value = player.name;
    $("playerNumber").value = player.number;
    $("playerPosition").value = player.position;
    $("playerPhoto").value = player.photo || "";
    $("playerForm").scrollIntoView({ behavior: "smooth" });
  }

  if (del && confirm("Excluir este jogador deste navegador?")) {
    players = players.filter(item =>
      item.id !== del.dataset.deletePlayer
    );
    if (saveData()) renderAll();
  }
});

// Atualiza a agenda mesmo quando a página fica aberta.
// A data/hora é verificada também ao carregar o site.
renderAll();
setInterval(renderAll, 30 * 1000);
</script>
</body>
</html>
